# Copy this file to .env.local and fill in your values

# Spring Boot API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8081

# App metadata
NEXT_PUBLIC_APP_NAME=TechStore KH
NEXT_PUBLIC_APP_DESCRIPTION=Cambodia's Premier Tech Store

# ─── Groq AI Chatbot ────────────────────────────────────────────────
# The chatbot calls Groq directly from the browser (no server relay needed).
# Get a free API key at: https://console.groq.com/keys
# If this is not set, users will be prompted to enter their key in the chat UI.
NEXT_PUBLIC_GROQ_API_KEY=gsk_your_groq_api_key_here
 